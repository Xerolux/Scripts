# ==============================================================================
# Xerolux APT Repository – Konfiguration
# ==============================================================================

# Basis
REPO_DIR="/var/www/clients/client1/web26/web"
LOG_FILE="/var/log/setup_local_repo.log"
REPO_URL="https://repo.xerolux.de"

# Paket-Quellen (Build-Output)
DOVECOT_PKG_DIR="/root/dovecot-packages"
POSTFIX_PKG_DIR="/root/postfix-packages"
NGINX_PKG_DIR="/root/nginx-packages"
PHP_PKG_DIR="/root/php-packages"

# Web-Server Berechtigungen
REPO_WEB_USER="web26"
REPO_WEB_GROUP="client1"

# Tage bis auto-promote testing→stable
REPO_PROMOTE_DAYS=14

# Architektur (leer = automatisch)
# REPO_ARCH="arm64"

# GPG
GPG_KEY_NAME="Xerolux Build Repo"
GPG_KEY_EMAIL="repo@xerolux.de"
# GPG_KEYRING_DIR="/root/.gnupg"
# GPG_KEY_ID=""  # Leere = automatisch erkennen
GPG_PUBLIC_KEY="/etc/apt/keyrings/xerolux-repo.gpg"

# apt Integration
APT_SOURCES_FILE="/etc/apt/sources.list.d/xerolux-repo.list"
APT_PREFS_FILE="/etc/apt/preferences.d/xerolux-repo.pref"

# Notification (optional – leer = deaktiviert)
REPO_NOTIFY_EMAIL=""
# REPO_NOTIFY_WEBHOOK="https://hooks.slack.com/services/XXX/YYY/ZZZ"

# Nginx Log fuer Download-Statistiken
REPO_NGINX_LOG="/var/log/nginx/repo.xerolux.de.access.log"
